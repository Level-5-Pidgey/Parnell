<Project>
  <!-- Keep dependency overrides and lock files in this repo, without editing submodules. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ECommons' Or '$(MSBuildProjectName)' == 'AutoRetainerAPI'">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>$(MSBuildThisFileDirectory)build/locks/$(MSBuildProjectName).packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'ECommons'">
    <PackageReference Update="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <!-- ECommons sheet rows require Lumina's ExcelPage rather than the client struct. -->
    <Using Include="Lumina.Excel.ExcelPage" Alias="ExcelPage" />
  </ItemGroup>

  <!-- Both the plugin and AutoRetainerAPI must use the same ECommons assembly. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'AutoRetainerAPI'">
    <PackageReference Remove="ECommons" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)external/ECommons/ECommons/ECommons.csproj" />
  </ItemGroup>
</Project>
